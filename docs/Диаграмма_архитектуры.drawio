инистратора." style="text;html=1;whiteSpace=wrap;align=left;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="977" width="1010" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>