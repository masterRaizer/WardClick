<mxfile host="app.diagrams.net" agent="WardClick coursework" version="24.0.0"><diagram name="Блок-схема" id="algo"><mxGraphModel dx="960" dy="1720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="1720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="algo-c-1" value="Общий алгоритм работы приложения «ВардКлик»" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="0" y="6" width="960" height="34" as="geometry"/></mxCell><mxCell id="algo-c-2" value="Начало" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=13;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="330.0" y="50" width="180" height="44" as="geometry"/></mxCell><mxCell id="algo-c-3" value="Запуск приложения: загрузка сессии и данных" style="rounded=0;html=1;whiteSpace=wrap;fontSize=13;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="275.0" y="124" width="290" height="56" as="geometry"/></mxCell><mxCell id="algo-c-4" value="Ввод: город, даты, число гостей, фильтры" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=18;html=1;whiteSpace=wrap;fontSize=13;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="250.0" y="210" width="340" height="56" as="geometry"/></mxCell><mxCell id="algo-c-5" value="Поиск особняков (список / карта)" style="rounded=0;html=1;whiteSpace=wrap;fontSize=13;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="275.0" y="296" width="290" height="56" as="geometry"/></mxCell><mxCell id="algo-c-6" value="Найдены особняки?" style="rhombus;html=1;whiteSpace=wrap;fon